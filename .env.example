# Optional: Groq boxing assistant. Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional: Clerk hosted sign-in UI. Create an application at https://clerk.com/
# Set both keys to enable sign-in and protect API routes.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated Clerk user IDs permitted to use admin APIs.
CLERK_ADMIN_USER_IDS=
# Alternatively, comma-separated verified Clerk emails permitted to use admin APIs.
CLERK_ADMIN_EMAILS=

# Optional locally; Vercel's Turso integration provides these for cloud deployment.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# The shorter names TURSO_DB_URL and TURSO_TOKEN are also accepted.
TURSO_DB_URL=
TURSO_TOKEN=
